# Local development. Use a remote libSQL/Turso URL for Vercel.
TURSO_DATABASE_URL="file:./data/grabstudent.db"
TURSO_AUTH_TOKEN=""
# Replace with a random value (32+ characters); never use the sample in production.
AUTH_SECRET="replace-this-with-at-least-32-random-characters"
# Used only by db:seed. Remote / production seeding requires a custom password.
ADMIN_EMAIL="admin@grabstudent.com"
ADMIN_PASSWORD=""
# Enable local demo shortcuts after npm run db:demo. Turn off for production.
NEXT_PUBLIC_DEMO_MODE="false"
# Optional Photon-compatible endpoint; the public Photon service is used by default.
# GEOCODING_BASE_URL="https://photon.komoot.io"
# Vercel sends this secret when invoking the monthly booking archive. Use 32+ random characters.
CRON_SECRET=""
# all removes the finished month's bookings, including active bookings, after saving PDFs.
# Use closed to keep active bookings; empty disables deletion. Wallet totals are retained.
BOOKING_RETENTION_MODE="all"
