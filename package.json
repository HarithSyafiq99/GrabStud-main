{
  "name": "grabstudent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "node --import tsx scripts/init-db.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:demo": "npm run db:seed && node --import tsx scripts/demo.ts",
    "test": "node --expose-gc --import tsx --test --test-concurrency=1 tests/integration.mjs tests/migrations.ts tests/wallet.ts tests/geocoding.ts tests/monthly-bookings.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests next.config.ts eslint.config.mjs README.md PANDUAN_MULA.md"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.2",
    "image-size": "^2.0.4",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "next": "15.5.27",
    "pdf-lib": "^1.17.1",
    "react": "19.1.6",
    "react-dom": "19.1.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.27",
    "prettier": "3.5.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
